---
import { profile } from '../data/profile';
const year = new Date().getFullYear();
---

<footer class="border-t border-neutral-200">
  <div class="mx-auto flex max-w-4xl flex-col gap-3 px-6 py-8 text-sm text-neutral-500 sm:flex-row sm:items-center sm:justify-between">
    <p>&copy; {year} {profile.name}. All rights reserved.</p>
    <div class="flex gap-4">
      <a href={`mailto:${profile.contact.email}`} class="hover:text-red-600">Email</a>
      <a href={profile.contact.blog} target="_blank" rel="noreferrer" class="hover:text-red-600">Blog</a>
      <a href={profile.contact.github} target="_blank" rel="noreferrer" class="hover:text-red-600">GitHub</a>
    </div>
  </div>
</footer>
