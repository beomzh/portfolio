---
import StackTag from './StackTag.astro';

interface Props {
  category: string;
  level: number;
  tags: string[];
}
const { category, level, tags } = Astro.props;
---

<div class="rounded-2xl border border-neutral-200 bg-white p-6">
  <div class="flex items-baseline justify-between">
    <h3 class="font-semibold text-neutral-900">{category}</h3>
    <span class="text-sm font-medium text-red-600">{level}%</span>
  </div>
  <div class="mt-3 h-2 w-full overflow-hidden rounded-full bg-neutral-100">
    <div class="h-full rounded-full bg-red-600" style={`width: ${level}%`}></div>
  </div>
  <div class="mt-4 flex flex-wrap gap-2">
    {tags.map((t) => <StackTag label={t} />)}
  </div>
</div>
