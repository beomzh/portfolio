---
import StackTag from './StackTag.astro';

interface Props {
  slug: string;
  title: string;
  domain: string;
  period: string;
  summary: string;
  stack: string[];
}
const { slug, title, domain, period, summary, stack } = Astro.props;
---

<a
  href={`/projects/${slug}`}
  class="group block rounded-2xl border border-neutral-200 bg-white p-6 transition hover:-translate-y-0.5 hover:border-red-200 hover:shadow-md"
>
  <div class="flex items-center justify-between gap-2 text-xs text-neutral-500">
    <span class="rounded-full bg-red-50 px-2.5 py-1 font-medium text-red-700">{domain}</span>
    <span>{period}</span>
  </div>
  <h3 class="mt-3 text-lg font-semibold text-neutral-900 group-hover:text-red-700">{title}</h3>
  <p class="mt-2 text-sm leading-relaxed text-neutral-600">{summary}</p>
  <div class="mt-4 flex flex-wrap gap-2">
    {stack.slice(0, 4).map((s) => <StackTag label={s} />)}
    {stack.length > 4 && <StackTag label={`+${stack.length - 4}`} />}
  </div>
</a>
