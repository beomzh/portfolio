---
import Layout from '../layouts/Layout.astro';
import SkillBar from '../components/SkillBar.astro';
import { career } from '../data/career';
import { skills } from '../data/skills';
import { certifications } from '../data/certifications';
---

<Layout title="Career & Skills">
  <section class="mx-auto max-w-4xl px-6 py-16">
    <h1 class="text-2xl font-bold tracking-tight text-neutral-900">Career Timeline</h1>

    <ol class="mt-8 space-y-8 border-l border-neutral-200 pl-6">
      {career.map((c) => (
        <li class="relative">
          <span class="absolute -left-[29px] top-1.5 h-3 w-3 rounded-full border-2 border-white bg-red-600"></span>
          <div class="flex flex-wrap items-baseline justify-between gap-2">
            <h2 class="font-semibold text-neutral-900">{c.company}</h2>
            <span class="text-sm text-neutral-500">
              {c.period}
              {c.current && <span class="ml-2 rounded-full bg-red-50 px-2 py-0.5 text-xs font-medium text-red-700">재직중</span>}
            </span>
          </div>
          <p class="mt-0.5 text-sm font-medium text-red-700">{c.role}</p>
          <ul class="mt-3 list-inside list-disc space-y-1 text-sm leading-relaxed text-neutral-600">
            {c.bullets.map((b) => <li>{b}</li>)}
          </ul>
        </li>
      ))}
    </ol>

    <h1 class="mt-16 text-2xl font-bold tracking-tight text-neutral-900">Skills</h1>
    <div class="mt-8 grid gap-4 sm:grid-cols-2">
      {skills.map((s) => <SkillBar category={s.category} level={s.level} tags={s.tags} />)}
    </div>

    <h1 class="mt-16 text-2xl font-bold tracking-tight text-neutral-900">Certifications</h1>
    <ul class="mt-6 space-y-3">
      {certifications.map((cert) => (
        <li class="flex flex-wrap items-center justify-between gap-2 rounded-xl border border-neutral-200 bg-white px-5 py-4">
          <div>
            <p class="font-medium text-neutral-900">{cert.name}</p>
            <p class="text-sm text-neutral-500">{cert.org}</p>
          </div>
          <span class="text-sm text-neutral-500">{cert.date}</span>
        </li>
      ))}
    </ul>
  </section>
</Layout>
