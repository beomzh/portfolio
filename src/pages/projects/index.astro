---
import Layout from '../../layouts/Layout.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('projects');
entries.sort((a, b) => a.data.order - b.data.order);
const featured = entries.filter((e) => e.data.featured);
const others = entries.filter((e) => !e.data.featured);
---

<Layout title="Projects">
  <section class="mx-auto max-w-4xl px-6 py-16">
    <h1 class="text-2xl font-bold tracking-tight text-neutral-900">Projects & Troubleshooting Cases</h1>
    <p class="mt-2 text-sm text-neutral-500">
      고객사명은 보안상 도메인으로 표기했습니다.
    </p>

    <h2 class="mt-10 text-sm font-semibold uppercase tracking-wide text-neutral-500">Highlights</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {featured.map((p) => (
        <ProjectCard
          slug={p.id}
          title={p.data.title}
          domain={p.data.domain}
          period={p.data.period}
          summary={p.data.summary}
          stack={p.data.stack}
        />
      ))}
    </div>

    <h2 class="mt-12 text-sm font-semibold uppercase tracking-wide text-neutral-500">More Projects</h2>
    <div class="mt-4 grid gap-4 sm:grid-cols-2">
      {others.map((p) => (
        <ProjectCard
          slug={p.id}
          title={p.data.title}
          domain={p.data.domain}
          period={p.data.period}
          summary={p.data.summary}
          stack={p.data.stack}
        />
      ))}
    </div>
  </section>
</Layout>
