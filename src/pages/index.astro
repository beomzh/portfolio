---
import Layout from '../layouts/Layout.astro';
import { profile } from '../data/profile';
import { getTotalExperience } from '../data/career';

const experience = getTotalExperience();
---

<Layout>
  <section class="mx-auto max-w-4xl px-6 py-16 sm:py-24">
    <div class="flex flex-col-reverse items-start gap-6 sm:flex-row sm:items-center sm:gap-8">
      <div class="min-w-0 flex-1">
        <div class="flex flex-wrap items-center gap-2">
          <p class="text-sm font-semibold uppercase tracking-wide text-sky-600">{profile.title}</p>
          <span class="rounded-full bg-lime-100 px-2.5 py-0.5 text-xs font-semibold text-lime-800">
            총 경력 {experience.label}
          </span>
        </div>
        <h1 class="mt-3 text-3xl font-bold leading-tight tracking-tight text-neutral-900 sm:text-4xl">
          {profile.tagline}
        </h1>
      </div>
      <img
        src={profile.photo}
        alt={`${profile.name} 프로필 사진`}
        width="128"
        height="128"
        class="h-28 w-28 flex-none rounded-2xl object-cover ring-1 ring-neutral-200 sm:h-32 sm:w-32"
      />
    </div>

    <div class="mt-5 flex flex-wrap gap-2">
      {profile.focusBadges.map((b) => (
        <span class="rounded-full border border-sky-200 bg-sky-50 px-3 py-1 text-xs font-medium text-sky-700">
          {b}
        </span>
      ))}
    </div>

    <div class="mt-8 space-y-3 text-base leading-relaxed text-neutral-700">
      {profile.intro.map((line) => <p>{line}</p>)}
    </div>

    <ul class="mt-8 grid gap-3 sm:grid-cols-2">
      {profile.highlights.map((h) => (
        <li class="flex items-start gap-3 rounded-xl border border-neutral-200 bg-white p-4 text-sm text-neutral-700">
          <span class="mt-1.5 h-1.5 w-1.5 flex-none rounded-full bg-sky-600"></span>
          <span>{h.text}</span>
        </li>
      ))}
    </ul>

    <div class="mt-10 flex flex-wrap gap-3">
      <a
        href="/projects"
        class="rounded-lg bg-sky-600 px-5 py-2.5 text-sm font-medium text-white transition hover:bg-sky-700"
      >
        프로젝트 사례 보기
      </a>
      <a
        href="/career"
        class="rounded-lg border border-neutral-300 bg-white px-5 py-2.5 text-sm font-medium text-neutral-800 transition hover:border-sky-300 hover:text-sky-700"
      >
        경력 & 기술스택 보기
      </a>
    </div>
  </section>
</Layout>
